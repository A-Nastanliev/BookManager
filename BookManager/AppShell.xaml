<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BookManager.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BookManager"
    xmlns:authentication="clr-namespace:BookManager.Views.Authentication"
    xmlns:book="clr-namespace:BookManager.Views.Book"
    xmlns:settings="clr-namespace:BookManager.Views.Settings"
    xmlns:reading="clr-namespace:BookManager.Views.Reading"
    Title="BookManager"
    Shell.FlyoutBehavior="Disabled">


    <ShellContent
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate authentication:LoadingPage}"
        Route="LoadingPage">
    </ShellContent>


    <ShellContent
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate authentication:LoginPage}"
        Route="LoginPage">
    </ShellContent>


    <ShellContent
        Shell.NavBarIsVisible="False"
        Shell.TabBarIsVisible="False"
        FlyoutItemIsVisible="False"
        ContentTemplate="{DataTemplate authentication:SignUpPage}"
        Route="SignUpPage">
    </ShellContent>

    <TabBar>
        <Tab Title="Books" Icon="search_icon.png">
            <ShellContent Title="Catalog"
              ContentTemplate="{DataTemplate book:BookSearchPage}"
              Route="BookSearchPage"/>
            <ShellContent Title="Book Attributes"  
                IsVisible="{Binding Role, Source={StaticResource User}, Converter={StaticResource RoleVisibilityConverter}, ConverterParameter=Admin}"
                ContentTemplate="{DataTemplate book:PublishingHubPage}"
                Route="CatalogManagementPage"/>
        </Tab>
        <Tab Title="Reading" Icon="book_icon.png">
            <ShellContent Title="Wishlist" ContentTemplate="{DataTemplate reading:UserBooksPage}" 
                Route="WishlistedBooksPage" />
            <ShellContent
                Title="Reading" ContentTemplate="{DataTemplate reading:UserBooksPage}"
                Route="ReadingdBooksPage" />
            <ShellContent Title="Finsihed" ContentTemplate="{DataTemplate reading:UserBooksPage}"
                Route="FinishedBooksPage" />
        </Tab>
        <Tab Title="Settings" Icon="settings_icon.png">
            <ShellContent Title="Settings"
                ContentTemplate="{DataTemplate settings:SettingsPage}"
                Route="SettingsPage"/>
        </Tab>
    </TabBar>
</Shell>
