<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BookManager.ViewModels.Settings"
             xmlns:passToggle="clr-namespace:BookManager.Views"
             x:DataType="vm:SettingsVM"
             x:Class="BookManager.Views.Settings.SettingsPage"
             xmlns:view="clr-namespace:BookManager.Views.Settings"
             Title="Settings">
    
    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="24" Spacing="20"
                   HorizontalOptions="Fill"
                   VerticalOptions="Start">

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Border
                         Stroke="{StaticResource Primary}" StrokeThickness="2"
                         StrokeShape="RoundRectangle 90" WidthRequest="180"
                         HeightRequest="180"  HorizontalOptions="Center"  VerticalOptions="Center">
                        <ImageButton  Source="{Binding ProfileImageSource}" Aspect="AspectFill"
                            Command="{Binding PickProfilePictureCommand}">
                            <ImageButton.Clip>
                                <EllipseGeometry Center="90,90" RadiusX="90" RadiusY="90" />
                            </ImageButton.Clip>
                        </ImageButton>
                    </Border>
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center"
                        IsVisible="{Binding IsPictureChanged}">
                        <Button Text="Confirm" Command="{Binding ConfirmProfilePictureCommand}" />
                        <Button Text="Cancel" Command="{Binding CancelProfilePictureCommand}" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding User.PublicUser.Username}" FontSize="Large" FontAttributes="Bold" 
                           TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <view:RestrictionView  BindingContext="{Binding Restriction, Source={StaticResource User}}"/>

            <Border Style="{StaticResource SectionCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Account Information" FontSize="Large" FontAttributes="Bold"/>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Username" FontAttributes="Bold" FontSize="Small"/>
                        <Label Text="{Binding User.PublicUser.Username}" Opacity="0.7"/>
                        <Entry Text="{Binding NewUsername}" Placeholder="Enter new username" MaxLength="30"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Email" FontAttributes="Bold" FontSize="Small"/>
                        <Label Text="{Binding User.EmailAddress}"  Opacity="0.7"/>
                        <Entry Text="{Binding NewEmail}" Placeholder="Enter new email" Keyboard="Email"/>
                    </VerticalStackLayout>
                    <Button Text="Save Changes" Command="{Binding UpdateUsernameEmailCommand}" HorizontalOptions="End" Margin="0"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource SectionCard}">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="*, Auto" ColumnSpacing="20" RowSpacing="10">
                    <Label Text="Change password" Grid.Row="0" FontSize="Medium" Grid.ColumnSpan="2" FontAttributes="Bold"/>
                    <Entry Text="{Binding OldPassword}" FontSize="Small"
                    x:Name="OldPasswordEntry" Placeholder="Old Password" IsPassword="True" Grid.Row="1" Grid.Column="0"/>
                    <passToggle:VisibilityButton Grid.Column="1" Grid.Row="1" TargetEntry="{x:Reference OldPasswordEntry}"/>
                    <Entry Text="{Binding NewPassword}"  FontSize="Small"
                    x:Name="NewPasswordEntry" Placeholder="New Password" IsPassword="True" Grid.Row="2" Grid.Column="0"/>
                    <passToggle:VisibilityButton Grid.Column="1" Grid.Row="2" TargetEntry="{x:Reference NewPasswordEntry}"/>
                    <Button Text="Update Password" HorizontalOptions="End" Command="{Binding UpdatePasswordCommand}" Grid.Row="3" 
                        FontSize="Small" Grid.ColumnSpan="2" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <Border 
                 IsVisible="{Binding Role, Source={StaticResource User}, Converter={StaticResource RoleVisibilityConverter}, ConverterParameter='Admin'}"
                 Style="{StaticResource SectionCard}">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="RestrictionsGesture"/>
                </Border.GestureRecognizers>

                <Label Text="Search Comment restrictions" Grid.Column="1" VerticalOptions="Center" FontSize="Medium" HorizontalOptions="Center" />
            </Border>

            <Border Style="{StaticResource SectionCard}"
                BackgroundColor="{StaticResource Gray950}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="Danger Zone" FontSize="Medium"
                       FontAttributes="Bold" HorizontalOptions="Center"
                       TextColor="Red" />

                    <HorizontalStackLayout Spacing="40" HorizontalOptions="Center">
                        <Button Text="Logout" Background="{StaticResource Gray400}" Command="{Binding LogoutCommand}" />
                        <Button Text="Delete" Background="Red" Command="{Binding DeleteAccountCommand}"
                            IsVisible="{Binding Role, Source={StaticResource User}, Converter={StaticResource RoleVisibilityConverter}, ConverterParameter='User'}"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>