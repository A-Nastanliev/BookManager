<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Settings.RestrictionView"
              xmlns:vm="clr-namespace:BookManager.Models.User"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:DataType="vm:RestrictionVM"
             x:Name="Root">
    
    <ContentView.IsVisible>
        <Binding Path="Id"
           Converter="{StaticResource NotEqualsConverter}">
            <Binding.ConverterParameter>
                <x:Int32>0</x:Int32>
            </Binding.ConverterParameter>
        </Binding>
    </ContentView.IsVisible>

    <Border Style="{StaticResource SectionCard}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
              Command="{Binding TapCommand, Source={x:Reference Root}}"
              CommandParameter="{Binding BindingContext, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="8" Background="Transparent" >

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                <Border
                WidthRequest="50"
                HeightRequest="50"
                StrokeThickness="1"
                Stroke="LightGray"
                StrokeShape="RoundRectangle 50"
                VerticalOptions="Center">

                    <Image Source="{Binding PublicUser.ProfilePictureSource}"
                       Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry
                            Center="25,25"
                            RadiusX="25"
                            RadiusY="25" />
                        </Image.Clip>
                    </Image>
                </Border>

                <Label
                Text="{Binding PublicUser.Username}"
                FontAttributes="Bold"
                FontSize="16"
                VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
            Text="{Binding Reason}"
            FontSize="14"
            LineBreakMode="WordWrap" />
            <HorizontalStackLayout Spacing="8">
                <VerticalStackLayout Spacing="8">
                    <Label
                    FontSize="12" Text="Start:"
                    TextColor="White" VerticalOptions="Center"/>
                    <Label
                     FontSize="12" Text="End:" TextColor="White" VerticalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label
                      Text="{Binding StartDate, Converter={StaticResource TimeConverter}}" FontSize="12"
                      TextColor="White" VerticalOptions="Center" HorizontalOptions="Start" />
                    <Label
                      Text="{Binding EndDate, Converter={StaticResource TimeConverter}, ConverterParameter='Undefined'}"
                      FontSize="12" VerticalOptions="Center" TextColor="White" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
