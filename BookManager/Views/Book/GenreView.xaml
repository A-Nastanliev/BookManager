<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Book.GenreView"
             xmlns:vm="clr-namespace:BookManager.Models.Book"
             x:DataType="vm:GenreVM"
             x:Name="Root">

    <Border
        Margin="0" StrokeShape="RoundRectangle 0" Padding="8,4" Stroke="{StaticResource Gray600}" StrokeThickness="1" >
        <Border.GestureRecognizers>
            <TapGestureRecognizer
             Command="{Binding TapCommand, Source={x:Reference Root}}"
             CommandParameter="{Binding BindingContext, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>
        <Label VerticalOptions="Center" Text="{Binding Name}" FontSize="Small" LineBreakMode="TailTruncation"/>
    </Border>
</ContentView>
