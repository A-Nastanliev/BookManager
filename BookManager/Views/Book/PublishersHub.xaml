<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Book.PublishersHub"
             xmlns:vm="clr-namespace:BookManager.ViewModels.Book"
             x:DataType="vm:PublishersHubVM"
             xmlns:views="clr-namespace:BookManager.Views.Book"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    
    <Grid RowDefinitions="*, auto">
        <Grid x:Name="PublisherGrid" RowDefinitions="Auto, *" RowSpacing="10" Grid.Row="0">
            <SearchBar Text="{Binding EntrySearch, Mode=TwoWay}" Placeholder="Enter publisher name"
                 BackgroundColor="Transparent" HorizontalOptions="Fill" Margin="0,0,4,0"/>
            <RefreshView IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}" Margin="12,0"
                 Command="{Binding RefreshCommand}" Grid.Row="1">
                <CollectionView VerticalOptions="Fill" 
                      ItemsSource="{Binding CurrentPublishers}"
                      RemainingItemsThreshold="3" VerticalScrollBarVisibility="Never"
                      RemainingItemsThresholdReachedCommand="{Binding LoadCommand}">

                    <CollectionView.EmptyView>
                        <Label  Text="No publishers found"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="8" HorizontalItemSpacing="8" Span="2"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <views:PublisherView x:DataType="views:PublisherView"
                            TapCommand="{Binding Source={RelativeSource FindAncestor, AncestorType={x:Type ContentView}}, Path=BindingContext.SelectCommand}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
        <Grid HeightRequest="60" WidthRequest="60" Grid.Row="1">
            <Button x:Name="ButtonBase" Command="{Binding GoToCreatePublisherCommand}" CornerRadius="20"/>
            <Image x:Name="Icon" Source="plus_icon.png" Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="40" WidthRequest="40">
                <Image.Behaviors>
                    <toolkit:IconTintColorBehavior TintColor="White" />
                </Image.Behaviors>
            </Image>
        </Grid>
    </Grid>
</ContentView>
