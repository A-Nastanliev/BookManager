<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Book.FormPage"
             xmlns:vm="clr-namespace:BookManager.ViewModels.Book"
             x:DataType="vm:FormVM"
             Title="{Binding Title}">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <VerticalStackLayout
                IsVisible="{Binding EntityType,
                            Converter={StaticResource EqualsConverter},
                            ConverterParameter=AuthorVM}">

                <Label Text="Name" Margin="4,0,0,0"/>
                <Entry Text="{Binding Author.Name}" />

                <Label Text="Biography" Margin="4,20,0,0" />
                <Editor MaxLength="1000"
                        AutoSize="TextChanges"
                        Text="{Binding Author.Biography}" />

                <Label Text="Birth Date"  Margin="4,20,0,0" />
                <DatePicker Date="{Binding Author.BirthDate}" Format="dd MMMM yyyy" />
            </VerticalStackLayout>


            <VerticalStackLayout
                IsVisible="{Binding EntityType,
                            Converter={StaticResource EqualsConverter},
                            ConverterParameter=PublisherVM}">

                <Label Text="Name" Margin="4,0,0,0"/>
                <Entry Text="{Binding Publisher.Name}" />

                <Label Text="Description" Margin="4,20,0,0" />
                <Editor MaxLength="500"
                        AutoSize="TextChanges" 
                        Text="{Binding Publisher.Description}" />

                <Label Text="Website" Margin="4,20,0,0" />
                <Entry Text="{Binding Publisher.Website}" />
            </VerticalStackLayout>

            <VerticalStackLayout
                IsVisible="{Binding EntityType,
                            Converter={StaticResource EqualsConverter},
                            ConverterParameter=GenreVM}">

                <Label Text="Name" Margin="4,0,0,0"/>
                <Entry Text="{Binding Genre.Name}" />

                <Label Text="Description" Margin="4,20,0,0" />
                <Editor MaxLength="500" 
                        AutoSize="TextChanges"
                        Text="{Binding Genre.Description}" />
            </VerticalStackLayout>


            <Button Text="{Binding SubmitButtonText}" Command="{Binding SubmitCommand}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>