<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Book.BookView"
             xmlns:vm="clr-namespace:BookManager.Models.Book"
             x:DataType="vm:BookVM"
             x:Name="Root">
    
    <Border
        Margin="6" StrokeShape="RoundRectangle 0"
        Padding="0">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding TapCommand, Source={x:Reference Root}}"
                CommandParameter="{Binding BindingContext, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Image
            Aspect="AspectFill"
            Source="{Binding CoverSource}" />

            <VerticalStackLayout
            Padding="10,4"
            Spacing="4"
            Background="{StaticResource PrimaryOverlay}"
            VerticalOptions="End">

                <Label
                Text="{Binding Title}"
                LineBreakMode="TailTruncation"
                FontAttributes="Bold"/>

                <Label
                Text="{Binding Author.Name}"
                FontSize="12"
                LineBreakMode="TailTruncation"/>

                <Label
                Text="{Binding Publisher.Name}"
                FontSize="10"/>
            </VerticalStackLayout>

        </Grid>
    </Border>
</ContentView>
