<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Book.RequestView"         
             xmlns:vm="clr-namespace:BookManager.Models.Reading"
             x:DataType="vm:BookRequestVM" 
             x:Name="Root">

    <ContentView.IsVisible>
        <Binding Path="Id"
        Converter="{StaticResource NotEqualsConverter}">
            <Binding.ConverterParameter>
                <x:Int32>0</x:Int32>
            </Binding.ConverterParameter>
        </Binding>
    </ContentView.IsVisible>

    <Border
        Style="{StaticResource SectionCard}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
            Command="{Binding TapCommand, Source={x:Reference Root}}"
            CommandParameter="{Binding BindingContext, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>
        <VerticalStackLayout Spacing="8" Background="Transparent" >
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start">
                <Border WidthRequest="50" HeightRequest="50" StrokeThickness="1" Stroke="LightGray"  StrokeShape="RoundRectangle 50" VerticalOptions="Center">
                    <Image Source="{Binding Sender.ProfilePictureSource}"
                       Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry
                            Center="25,25"
                            RadiusX="25"
                            RadiusY="25" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Label
                Text="{Binding Sender.Username}" FontAttributes="Bold" FontSize="Medium" VerticalOptions="Center" />
            </HorizontalStackLayout>


            <HorizontalStackLayout Spacing="8">
                <VerticalStackLayout Spacing="8">
                    <Label FontSize="Small" Text="Title:" TextColor="White" VerticalOptions="Center"/>
                    <Label FontSize="Small" Text="ISBN:" TextColor="White" VerticalOptions="Center"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Title}" FontSize="Small" LineBreakMode="WordWrap" VerticalOptions="Center" />
                    <Label Text="{Binding Isbn}" FontSize="Small"  LineBreakMode="WordWrap"  VerticalOptions="Center" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <VerticalStackLayout Spacing="8">
                    <Label
                 FontSize="Micro" Text="Sent:"
                 TextColor="White" VerticalOptions="Center" />
                    <Label FontSize="Micro" Text="Handled:" TextColor="White" VerticalOptions="Center"
                    IsVisible="{Binding DateActioned, Converter={StaticResource NotEqualsConverter}, ConverterParameter={x:Null}}"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label
                 Text="{Binding DateSent, Converter={StaticResource TimeConverter}}" FontSize="Micro"
                 TextColor="White" VerticalOptions="Center" HorizontalOptions="Start" />
                    <Label  IsVisible="{Binding DateActioned, Converter={StaticResource NotEqualsConverter}, ConverterParameter={x:Null}}"
                 Text="{Binding DateActioned, Converter={StaticResource TimeConverter}}"
                 FontSize="Micro" VerticalOptions="Center" TextColor="White" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="6" HorizontalOptions="Start" VerticalOptions="Center" 
            IsVisible="{Binding DateActioned, Converter={StaticResource NotEqualsConverter}, ConverterParameter={x:Null}}">
                <Label Text="By" FontSize="Micro" VerticalOptions="Center" />
                <Border
                WidthRequest="25" HeightRequest="25" StrokeThickness="1"
                 Stroke="LightGray" StrokeShape="RoundRectangle 25" VerticalOptions="Center">
                    <Image Source="{Binding ActionedBy.ProfilePictureSource}"
                     Aspect="AspectFill" VerticalOptions="Center">
                        <Image.Clip>
                            <EllipseGeometry  Center="12.5,12.5" RadiusX="12.5" RadiusY="12.5" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Label Text="{Binding ActionedBy.Username}" FontSize="Small" VerticalOptions="Center"
             FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
