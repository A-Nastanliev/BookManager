<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Reading.ReadingLogView"
             xmlns:vm="clr-namespace:BookManager.Models.Reading"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:ReadingLogVM"
             x:Name="Root">
    
    <Border Style="{StaticResource SectionCard}" Padding="12">
        <Border.Behaviors>
            <toolkit:TouchBehavior
                LongPressCommand="{Binding DeleteCommand, Source={x:Reference Root}}"
                LongPressCommandParameter="{Binding BindingContext, Source={x:Reference Root}}"
                LongPressDuration="2300" />
        </Border.Behaviors>
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Date, Converter={StaticResource TimeConverter}}"
              FontSize="Small" HorizontalOptions="Center"/>
            <Grid ColumnDefinitions="*,*,*">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Label Text="Start:" FontSize="Medium" VerticalOptions="Center" />
                    <Label Text="{Binding StartingPage}" FontSize="Medium" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout HorizontalOptions="Center" Grid.Column="1" Spacing="8">
                    <Label Text="End:" FontSize="Medium" VerticalOptions="Center" />
                    <Label Text="{Binding EndingPage}" FontSize="Medium" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="8">
                    <Label Text="Read:" FontSize="Medium" VerticalOptions="Center"/>
                    <Label Text="{Binding PagesRead}" FontSize="Medium" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
