<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BookManager.Views.Reading.CommentView"
             xmlns:vm="clr-namespace:BookManager.Models.Reading"
             x:DataType="vm:CommentVM"
             x:Name="Root">
    
    <ContentView.IsVisible>
        <Binding Path="Id"
        Converter="{StaticResource NotEqualsConverter}">
            <Binding.ConverterParameter>
                <x:Int32>0</x:Int32>
            </Binding.ConverterParameter>
        </Binding>
    </ContentView.IsVisible>

    <Border Style="{StaticResource SectionCard}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer
           Command="{Binding TapCommand, Source={x:Reference Root}}"
           CommandParameter="{Binding BindingContext, Source={x:Reference Root}}"/>
        </Border.GestureRecognizers>
        <Grid RowSpacing="8" Background="Transparent" RowDefinitions="Auto, Auto, Auto">

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" HorizontalOptions="Start" Grid.Row="0">
                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="1" Stroke="LightGray" StrokeShape="RoundRectangle 40" VerticalOptions="Center">
                    <Image Source="{Binding PublicUser.ProfilePictureSource}"  Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                        </Image.Clip>
                    </Image>
                </Border>

                <Label Text="{Binding PublicUser.Username}" FontAttributes="Bold" FontSize="Small" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding Comment}" FontSize="Small" LineBreakMode="WordWrap" Grid.Row="1" />

            <Grid RowDefinitions="Auto, Auto" RowSpacing="4" ColumnSpacing="8" Grid.Row="2">
                <HorizontalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Start">
                    <Label FontSize="Small" Text="Sent:" VerticalOptions="Center"/>
                    <Label FontSize="Small" VerticalOptions="Center" 
                            Text="{Binding DateTime, Converter={StaticResource TimeConverter}}"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="Start">
                    <Label FontSize="Small" Text="Pages read:" VerticalOptions="Center"/>
                    <Label FontSize="Small" VerticalOptions="Center"
                   Text="{Binding UserPageProgress}"/>
                </HorizontalStackLayout>
            </Grid>
        </Grid>
    </Border>
</ContentView>
