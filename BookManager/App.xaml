<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BookManager"
             xmlns:converters="clr-namespace:BookManager.Converters"
             x:Class="BookManager.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:RoleVisibilityConverter x:Key="RoleVisibilityConverter"/>
            <converters:IntToStringConverter x:Key="IntToStringConverter"/>
            <converters:EqualsConverter x:Key="EqualsConverter"/>
            <converters:EqualsConverter x:Key="NotEqualsConverter" Invert="True"/>
            <converters:EqualsMultiConverter x:Key="EqualsMultiConverter" />
            <converters:EqualsMultiConverter x:Key="NotEqualsMultiConverter" Invert="True"/>
            <converters:TimeConverter x:Key="TimeConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
